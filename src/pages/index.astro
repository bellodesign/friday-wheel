---
import WheelOfFortune from '../components/WheelOfFortune.astro';
import Layout from '../layouts/Layout.astro';

// `day` query param overrides the real day for testing (0=Sun … 6=Sat)
const dayParam = Astro.url.searchParams.get('day');
const day = dayParam !== null ? parseInt(dayParam, 10) : new Date().getDay();
const isFriday = day === 5;
---

<Layout>
  <WheelOfFortune isFriday={isFriday} />
</Layout>

